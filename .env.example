# Copiar para .env.local (desenvolvimento com `npm run dev`). NUNCA pôr valores reais neste ficheiro.
# Em produção, estes valores são "Secrets" do Worker na Cloudflare (ver docs/DEPLOYMENT.md).

# Chave da conta Resend (https://resend.com/api-keys), permissão "Sending access".
RESEND_API_KEY=
# Caixa que recebe os pedidos do formulário.
CONTACT_TO_EMAIL=geral@otenmotors.com
# Remetente (o domínio tem de estar verificado no Resend).
CONTACT_FROM_EMAIL=OTEN MOTORS <site@otenmotors.com>
